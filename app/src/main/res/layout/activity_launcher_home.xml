<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.LauncherHomeActivity">

    <!-- centerCrop keeps the wallpaper's aspect ratio (a View background would stretch it). -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Full height, so the App Library can scroll down to the bottom of the screen.
             Home pages get a bottom padding from code (LauncherHomeActivity.applyHomePageBottomSpace)
             that keeps their icons above the search pill and dock, exactly as before. -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/homePager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Real backdrop blur behind the search pill - only shown while Blur Effect is on
             (LauncherHomeActivity); same shape as home_glass_pill_background so it clips cleanly. -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/searchPillBlurView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_blur_mask_pill"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/searchPill"
            app:layout_constraintEnd_toEndOf="@id/searchPill"
            app:layout_constraintStart_toStartOf="@id/searchPill"
            app:layout_constraintTop_toTopOf="@id/searchPill" />

        <!-- Small iOS "Search" pill -->
        <TextView
            android:id="@+id/searchPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/home_glass_pill_background"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="26dp"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/home_search"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_home_search"
            app:layout_constraintBottom_toTopOf="@id/dock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Page dots sit exactly where the pill is; they show while swiping. -->
        <LinearLayout
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:gravity="center"
            android:background="@drawable/home_glass_pill_background"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="@id/searchPill"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/searchPill" />

        <!-- Real backdrop blur behind the dock - only shown while Blur Effect is on
             (LauncherHomeActivity); same shape as home_dock_background so it clips cleanly. -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/dockBlurView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_blur_mask_dock"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/dock"
            app:layout_constraintEnd_toEndOf="@id/dock"
            app:layout_constraintStart_toStartOf="@id/dock"
            app:layout_constraintTop_toTopOf="@id/dock" />

        <!-- Dock: 60dp icons + 16dp vertical padding = 92dp tall, like the Figma dock.
             minHeight keeps its size while an icon is dragged out of it. -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/home_dock_background"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <TextView
            android:id="@+id/doneButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/home_search_pill_background"
            android:fontFamily="sans-serif-medium"
            android:minHeight="30dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/edit_mode_done"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Overlay for the floating icon while dragging. Not clickable, so touches pass through. -->
    <FrameLayout
        android:id="@+id/dragLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <FrameLayout
        android:id="@+id/menuLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Shown until the first app list / layout load finishes, so the user never sees the
        half-built page (widget with no apps, empty dock) while loadHomeInBackground() runs.
        Visible by default; LauncherHomeActivity hides it once loading completes.
    -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33000000"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@android:color/white" />

    </FrameLayout>

    <!--
        Open-folder view: dark scrim + title + a translucent rounded panel holding the folder's
        apps (iOS style). Hidden by default; LauncherHomeActivity shows/populates it on tap.
        Tapping the scrim (outside the panel) closes it without launching anything.
    -->
    <com.example.launcherapp.views.HolePunchScrimView
        android:id="@+id/folderOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/folderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/folderPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/folder_panel_background"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="260dp"
                android:padding="12dp">

                <!-- Real backdrop blur behind the panel - only shown while Blur Effect is on
                     (LauncherHomeActivity). Constrained to folderGridScroll's own resolved bounds
                     (not match_parent) so its size can never be mis-measured larger than the real
                     content - folderPanel's clipToOutline rounds its corners. -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/folderBlurView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/folderGridScroll"
                    app:layout_constraintEnd_toEndOf="@id/folderGridScroll"
                    app:layout_constraintStart_toStartOf="@id/folderGridScroll"
                    app:layout_constraintTop_toTopOf="@id/folderGridScroll" />

                <com.example.launcherapp.views.MaxHeightScrollView
                    android:id="@+id/folderGridScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <android.widget.GridLayout
                        android:id="@+id/folderGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="3" />

                </com.example.launcherapp.views.MaxHeightScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </com.example.launcherapp.views.HolePunchScrimView>

</androidx.constraintlayout.widget.ConstraintLayout>