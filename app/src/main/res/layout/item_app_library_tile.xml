<?xml version="1.0" encoding="utf-8"?>
<!--
    One App Library tile, sized like the Figma frame:
    - the tile fills its column (8dp side padding here + 8dp on the RecyclerView = 16dp edges / 16dp gap)
      and is square (SquareFrameLayout);
    - 12dp from the tile edge to the icons (7dp tile padding + 5dp slot padding), 10dp between icons;
    - slots 0-2 = large icons, slot 3 = 4th large icon or a 2x2 mini cluster (AppLibraryAdapter).
    All sizes are weight-based, so icons scale with the screen width.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="14dp">

    <com.example.launcherapp.views.SquareFrameLayout
        android:id="@+id/tileBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_catagory_sugestion"
        android:padding="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/slot0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp" />

                <FrameLayout
                    android:id="@+id/slot1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/slot2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp" />

                <FrameLayout
                    android:id="@+id/slot3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="5dp" />

            </LinearLayout>

        </LinearLayout>

    </com.example.launcherapp.views.SquareFrameLayout>

    <TextView
        android:id="@+id/groupLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#59000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

</LinearLayout>