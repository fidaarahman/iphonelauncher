<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="20dp"
    android:paddingTop="@dimen/home_grid_padding_top"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Suggested apps for this space - most-used, falling back to sensible defaults (phone,
             messages, browser, etc.) on a fresh install so it's never empty. Same source as the App
             Library's own "Suggestions" tile and the same card style as SearchActivity's own
             Suggestions grid. Cells are added in code (LauncherHomeActivity.bindWidgetsSuggestions). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/search_suggestions_header"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <android.widget.GridLayout
            android:id="@+id/widgetsSuggestionsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_search_card"
            android:columnCount="4"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_library_title"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <!-- ===================== Row 1: Clock | Sunset ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Clock: white iOS face, drawn entirely in code (live hands). -->
            <com.example.launcherapp.views.SquareFrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.example.launcherapp.views.LightClockWidgetView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.example.launcherapp.views.SquareFrameLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <!-- Sunset: Figma background + the Figma sun-arc curve (SunArcView) with a sun that
                 moves with the time of day. No padding on the tile so the curve spans edge to edge. -->
            <com.example.launcherapp.views.SquareFrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_sunset">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_widget_sunset_small" />

                        <TextView
                            android:id="@+id/weatherSunsetLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/widget_sunset_label"
                            android:textAllCaps="true"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/weatherSunsetTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/widget_placeholder_dash"
                        android:textColor="@android:color/white"
                        android:textSize="22sp" />

                </LinearLayout>

                <com.example.launcherapp.views.SunArcView
                    android:id="@+id/sunArc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/weatherSunriseTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

            </com.example.launcherapp.views.SquareFrameLayout>

        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="14dp" />

        <!-- ===================== Row 2: Control Center | Photo ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.example.launcherapp.views.SquareFrameLayout
                android:id="@+id/controlCenterTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_controll_setting"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/widget_control_center_label"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </com.example.launcherapp.views.SquareFrameLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <!-- Photo: latest gallery photo, clipped to the tile's rounded shape. -->
            <com.example.launcherapp.views.SquareFrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_photo"
                android:clipToOutline="true"
                android:outlineProvider="background">

                <ImageView
                    android:id="@+id/photoTileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </com.example.launcherapp.views.SquareFrameLayout>

        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="14dp" />

        <!-- ===================== Row 3: Battery | Wallpapers ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Battery: green ring around the phone icon, filled to the battery level.
                 BatteryRingView updates itself AND the batteryPercent text live. -->
            <com.example.launcherapp.views.SquareFrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_battery_count">

                <com.example.launcherapp.views.BatteryRingView
                    android:id="@+id/batteryRing"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/batteryPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/widget_placeholder_dash"
                    android:textColor="@android:color/black"
                    android:textSize="32sp" />

            </com.example.launcherapp.views.SquareFrameLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <com.example.launcherapp.views.SquareFrameLayout
                android:id="@+id/wallpapersTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_walpapers"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/widget_wallpapers_label"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </com.example.launcherapp.views.SquareFrameLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>