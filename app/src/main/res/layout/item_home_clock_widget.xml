<?xml version="1.0" encoding="utf-8"?>
<!--
    2x2 clock widget. HomeCellLayout sets widgetBody's width/height at measure time so the
    tile lines up with the surrounding icons and the "Clock" label sits on the same line as
    the app labels beside it. The 150dp here is only a preview size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/home_widget_clock"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/home_cell_padding_top">

    <com.example.launcherapp.ui.views.ClockWidgetView
        android:id="@+id/widgetBody"
        android:layout_width="150dp"
        android:layout_height="150dp" />

    <TextView
        style="@style/HomeIconLabel"
        android:text="@string/home_widget_clock" />

</LinearLayout>
