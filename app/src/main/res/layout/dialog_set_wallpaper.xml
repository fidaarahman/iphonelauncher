<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_rounded_top"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/wallpaper_sheet_title"
            android:textColor="@color/splash_title"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/optionLockScreen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_wallpaper_option_selected"
            android:gravity="center"
            android:text="@string/wallpaper_sheet_lock_screen"
            android:textColor="@color/splash_title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/optionHomeScreen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/settings_card_background"
            android:gravity="center"
            android:text="@string/wallpaper_sheet_home_screen"
            android:textColor="@color/splash_title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/optionBoth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/settings_card_background"
            android:gravity="center"
            android:text="@string/wallpaper_sheet_both"
            android:textColor="@color/splash_title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/sheetApply"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_green"
            android:gravity="center"
            android:text="@string/wallpaper_sheet_apply"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Swapped in for sheetContent while the wallpaper is being applied - WallpaperManager.setBitmap
         can take a noticeable moment, so this keeps the user from staring at a frozen sheet. -->
    <LinearLayout
        android:id="@+id/applyingOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_rounded_top"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="40dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/ios_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/wallpaper_sheet_applying"
            android:textColor="@color/splash_title"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
