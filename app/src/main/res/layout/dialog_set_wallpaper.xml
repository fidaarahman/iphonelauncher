<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/splash_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/wallpaper_sheet_title"
        android:textColor="@color/splash_title"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/optionLockScreen"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_wallpaper_option_selected"
        android:gravity="center"
        android:text="@string/wallpaper_sheet_lock_screen"
        android:textColor="@color/splash_title"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optionHomeScreen"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/settings_card_background"
        android:gravity="center"
        android:text="@string/wallpaper_sheet_home_screen"
        android:textColor="@color/splash_title"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/optionBoth"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/settings_card_background"
        android:gravity="center"
        android:text="@string/wallpaper_sheet_both"
        android:textColor="@color/splash_title"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/sheetApply"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_green"
        android:gravity="center"
        android:text="@string/wallpaper_sheet_apply"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
