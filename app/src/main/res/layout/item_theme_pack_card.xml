<?xml version="1.0" encoding="utf-8"?>
<!--
    Mini "home screen" preview card for one theme pack: a clock tile, the user's own first-page
    icons (recoloured in the pack's colour by ThemePackAdapter), and a dock row, all over the
    pack's own gradient. cardRoot's background + selectionRing are set at bind time in the adapter.
    cardLabel is only shown on the "Default" card (no theme).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    android:layout_margin="6dp">

    <FrameLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_tile_card"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:outlineProvider="background"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:id="@+id/cardClock"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_theme_card_clock" />

            <android.widget.GridLayout
                android:id="@+id/cardIconGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:columnCount="4"
                android:rowCount="2" />

            <LinearLayout
                android:id="@+id/cardDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_theme_card_dock"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/cardLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/theme_pack_default"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <View
        android:id="@+id/selectionRing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_theme_card_selected_ring"
        android:visibility="gone" />

</FrameLayout>