<?xml version="1.0" encoding="utf-8"?>
<!-- The actual floating Control Center panel, added over other apps by ControlCenterAccessibilityService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_control_center_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_rounded_white_4dp"
        android:alpha="0.5" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Flashlight -->
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/ccFlashlightTile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_chip_round_off">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_glyph_flashlight" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/control_center_tile_flashlight"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- WiFi -->
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/ccWifiTile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_chip_round_blue">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_glyph_wifi" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/control_center_tile_wifi"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Bluetooth -->
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/ccBluetoothTile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_chip_round_indigo">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_glyph_bluetooth" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/control_center_tile_bluetooth"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Airplane Mode -->
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/ccAirplaneTile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_chip_round_off">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_glyph_airplane" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/control_center_tile_airplane"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
