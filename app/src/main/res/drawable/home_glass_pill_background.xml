<?xml version="1.0" encoding="utf-8"?>
<!--
    Teal "glass" capsule used behind the home Search pill and the page dots.
    Mostly opaque on purpose, so it stays readable on light, dark and busy wallpapers
    (the old #38000000 fill could disappear on dark wallpapers).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base tint: slightly deeper teal on the left, lighter on the right (as in the Figma pill). -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#E64FC1D1"
                android:endColor="#E67FD9E4"
                android:type="linear" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- Soft gloss on the top half, gives the glassy look. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- Light rim around the edge. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#73FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>

</layer-list>
