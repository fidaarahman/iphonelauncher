<?xml version="1.0" encoding="utf-8"?>
<!--
    flagRequestAccessibilityButton puts this service's own icon in the floating accessibility
    button stack, tappable as a second, much more discoverable way to open Control Center
    alongside the swipe gesture (see ControlCenterAccessibilityService.onAccessibilityButtonClicked).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestAccessibilityButton"
    android:canRetrieveWindowContent="false"
    android:description="@string/control_center_accessibility_service_description"
    android:notificationTimeout="100" />
